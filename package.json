{
  "name": "thincoder-webui",
  "private": true,
  "version": "0.12.0",
  "description": "Codex 式 Web 客户端 for thincoder —— 零依赖 Node 桥接层 + 浏览器工作台",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "thincoder": "^0.12.66"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "build": "npm --prefix web run build",
    "dev": "node scripts/dev.mjs",
    "postinstall": "npm --prefix web install --include=dev && node scripts/patch-core.mjs"
  },
  "license": "MIT"
}
